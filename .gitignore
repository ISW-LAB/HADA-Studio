# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Model weights and training artefacts (large; regenerate with tools/)
*.pt
*.pth
artifacts/
workspace/
runs/
.pgtrain/

# App state — written by the app beside the user's labels; never source
# The bundled samples are a labeling TARGET: opening either one writes .txt beside the images
# (dataset_setup.default_labels_dir puts labels next to the images in a checkout), so simply
# running the app would otherwise leave the tree dirty. The labels are user data, not source.
demo/images/*.txt
data/labels/*.txt
!data/labels/1 (10).txt
!data/labels/1 (100).txt
!data/labels/1 (101).txt
!data/labels/1 (104).txt
settings.json
logs/
.pglabel-packaged
.pglabel_classes.json
.pglabel_human.json
instances_export.json

# Packaging output
packaging/build/
packaging/dist/
# NOTE: packaging/assets/pglabel.ico is COMMITTED on purpose. The spec and the installer name it
# by path, and verify_build.py requires it — a clone without it fails its own release gate.
# It is regenerated by packaging/make_icon.py if it ever needs to change.

# OS
.DS_Store
Thumbs.db
